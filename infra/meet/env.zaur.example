# Merge these into the upstream docker-jitsi-meet `.env` (after `cp env.example .env`
# and `./gen-passwords.sh`). Do not replace the whole file — passwords and image
# tags come from upstream + gen-passwords.

CONFIG=/opt/jitsi-meet-cfg
TZ=Europe/Warsaw

# Public HTTPS URL browsers use (TLS terminates at Traefik/Caddy/Dokploy).
PUBLIC_URL=https://meet.zaur.app

# HTTP-only behind the reverse proxy.
HTTP_PORT=8000
# Avoid host :8443 conflicts (Contabo nginx); TLS terminates at Traefik.
HTTPS_PORT=18443
DISABLE_HTTPS=1
ENABLE_HTTP_REDIRECT=0
ENABLE_LETSENCRYPT=0

# Contabo public IPv4 — required so browsers can send WebRTC media to JVB.
# JVB_ADVERTISE_IPS=203.0.113.10
JVB_PORT=10000

# Optional: quieter lobby for a small team
# ENABLE_GUESTS=1
# ENABLE_LOBBY=1
