# Signing key for the session cookie. Required in production.
SESSION_SECRET=

# Zaur sign-in: mail2 is the OIDC issuer. The client is registered in mail2's
# OIDC_PROVIDER_CLIENTS with redirect URI <origin>/auth/callback.
OIDC_ISSUER=https://webmail.zaur.app
OIDC_CLIENT_ID=music
OIDC_CLIENT_SECRET=

# Navidrome, the library. The admin account creates one Navidrome user per
# Zaur address; NAVIDROME_USER_KEY derives those users' passwords.
NAVIDROME_URL=http://navidrome:4533
NAVIDROME_ADMIN_USER=zaur-music
NAVIDROME_ADMIN_PASSWORD=
NAVIDROME_USER_KEY=

# Where "Add from YouTube" writes: the library root as this container sees it.
# Tracks land in <MUSIC_DIR>/YouTube/<artist>/.
MUSIC_DIR=/music
# YouTube asks server IPs to "sign in to confirm you're not a bot". A Netscape
# cookies.txt exported from a browser signed in to YouTube gets past it; it must
# be writable (yt-dlp saves refreshed cookies back). Unset: no cookies.
YTDLP_COOKIES=
# Or let Yattee Server fetch from YouTube (signed in, on another host) and
# only download the file here. Set: yt-dlp and YTDLP_COOKIES go unused.
YATTEE_URL=
YATTEE_USER=
YATTEE_PASSWORD=
