{
	"name": "@zaur/web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"description": "Catalog site for zaur.app: apps, npm packages, Railway templates and websites by one maker.",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node static-server.mjs",
		"test": "node --test stats.test.mjs search.test.mjs",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
	},
	"engines": {
		"node": ">=22.17"
	},
	"devDependencies": {
		"@nomideusz/svelte-media": "^1.0.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^25.9.1",
		"sharp": "^0.35.5",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"typescript": "^6.0.2",
		"vite": "^8.3.4"
	},
	"dependencies": {
		"@nomideusz/svelte-calendar": "^1.7.1",
		"@nomideusz/svelte-geometrize": "^0.9.3",
		"@nomideusz/svelte-i18n": "^1.0.0",
		"@nomideusz/svelte-notify": "^1.1.1",
		"@nomideusz/svelte-payments": "^0.5.0",
		"@nomideusz/svelte-qr": "^1.0.0",
		"@nomideusz/svelte-scheduler": "^0.4.3",
		"@nomideusz/svelte-search": "^0.4.2",
		"@nomideusz/zaur-world": "^1.8.0"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
