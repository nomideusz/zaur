{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"sourceMap": true,
		"types": ["$app/types", "node"],
		"paths": {
			"#lib/*": ["./src/lib/*"]
		}
	},
	"include": [
		".svelte-kit/ambient.d.ts",
		".svelte-kit/non-ambient.d.ts",
		".svelte-kit/types/**/$types.d.ts",
		"vite.config.ts",
		"src/**/*.js",
		"src/**/*.ts",
		"src/**/*.svelte",
		"tests/**/*.js",
		"tests/**/*.ts"
	],
	"exclude": ["node_modules/**", ".svelte-kit/output/**", ".svelte-kit/generated/**"]
}
