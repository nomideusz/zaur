# Zaur sign-in: mail2 is the OIDC issuer. Register this client in mail2's
# OIDC_PROVIDER_CLIENTS with redirect URI <origin>/auth/callback.
OIDC_ISSUER=https://webmail.zaur.app
OIDC_CLIENT_ID=stats
OIDC_CLIENT_SECRET=
# Who may read the dashboard, comma-separated. Nobody when empty.
STATS_ADMINS=
SESSION_SECRET=
# adapter-node: the public origin, or kit cannot tell its own POSTs.
ORIGIN=https://stats.zaur.app

# The store, and where the offline IP databases are downloaded to.
STATS_DB=/data/stats.db
GEO_DIR=/data/geo
# Networks that are always the owner's, |-separated.
OWN_NETWORKS=Jakub Skorek trading as MCG
# Only for zaur.app, which alone looks an address up at ipapi.is (sites.ts).
IPAPI_KEY=

# Development only, ignored in production: read the dashboard as this address.
# STATS_DEV_USER=you@zaur.app
