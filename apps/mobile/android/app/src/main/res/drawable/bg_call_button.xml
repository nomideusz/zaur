<?xml version="1.0" encoding="utf-8"?>
<!-- A call control: the dark surface, or the red wash when it is off (activated), as on the web. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/call_off_fill" />
            <stroke android:width="1dp" android:color="@color/call_off_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/call_surface" />
            <stroke android:width="1dp" android:color="@color/call_line" />
        </shape>
    </item>
</selector>
